# ==================== Required Environment Variables ====================
# These MUST be set for the bot to work

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_TOKEN=123456789:ABC-your-token-here


# ==================== Optional Environment Variables ====================
# These are optional and have default values

# WhatsApp/Twilio (for future WhatsApp integration)
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx

# Ngrok (for exposing local server)
# NGROK_AUTHTOKEN=xxxxx

# Base URL for webhooks (used by WhatsApp/Twilio)
# BASE_URL=https://your-ngrok-url.ngrok-free.dev


# ==================== OpenAI Configuration ====================
# Customize AI behavior (optional - defaults are provided)

# LLM Model (default: gpt-4o)
# LLM_MODEL=gpt-4o

# LLM Temperature (0.0-2.0, default: 0.7)
# LLM_TEMPERATURE=0.7

# Whisper Model (default: whisper-1)
# WHISPER_MODEL=whisper-1

# TTS Model (default: tts-1)
# TTS_MODEL=tts-1

# TTS Voice (options: alloy, echo, fable, onyx, nova, shimmer)
# TTS_VOICE=onyx

# Vision API Max Tokens (default: 300)
# VISION_MAX_TOKENS=300


# ==================== Application Settings ====================
# Fine-tune application behavior (optional)

# Maximum number of sessions to keep in memory (default: 1000)
# MAX_SESSION_SIZE=1000

# Session time-to-live in hours (default: 24)
# SESSION_TTL_HOURS=24

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Log file path (default: elo_bot.log)
# LOG_FILE=elo_bot.log
